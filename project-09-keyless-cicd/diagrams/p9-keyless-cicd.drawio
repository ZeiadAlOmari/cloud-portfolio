<mxfile host="app.diagrams.net"><diagram id="p8" name="Portfolio WA map"><mxGraphModel dx="1700" dy="1060" grid="1" gridSize="10" guides="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1060" background="#0B1426" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Project 9 — Keyless CI/CD for Project 1 (GitHub OIDC → AWS IAM) with a Checkov policy gate" style="text;html=1;fontColor=#FFFFFF;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1620" height="50" as="geometry"/></mxCell><mxCell id="dev" value="&lt;b style=&#x27;font-size:14px&#x27;&gt;Developer laptop&lt;/b&gt;&lt;br&gt;Terraform 1.17.2 · Checkov 3.4.5&lt;br&gt;aws login (MFA, short-lived)&lt;br&gt;Bootstrap stack: local state" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#13233F;strokeColor=#60A5FA;strokeWidth=2;fontColor=#FFFFFF;fontSize=12;arcSize=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="280" height="120" as="geometry"/></mxCell><mxCell id="gh" value="&lt;b style=&#x27;font-size:14px&#x27;&gt;GitHub repository&lt;/b&gt;&lt;br&gt;Pull request or merge to main&lt;br&gt;Ruleset protect-main:&lt;br&gt;  Checkov check required&lt;br&gt;  no force push / deletion&lt;br&gt;Secrets: role ARNs only (no keys)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#13233F;strokeColor=#60A5FA;strokeWidth=2;fontColor=#FFFFFF;fontSize=12;arcSize=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="330" width="280" height="170" as="geometry"/></mxCell><mxCell id="gate" value="&lt;b style=&#x27;font-size:14px&#x27;&gt;Policy gate · Checkov&lt;/b&gt;&lt;br&gt;P1: 23 passed · 0 failed · 11 skipped&lt;br&gt;Bootstrap: 75 · 0 · 4&lt;br&gt;Skips documented in code&lt;br&gt;Fail → plan and apply skipped" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#13233F;strokeColor=#FBBF24;strokeWidth=2;fontColor=#FFFFFF;fontSize=12;arcSize=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="420" y="330" width="300" height="140" as="geometry"/></mxCell><mxCell id="oidc" value="&lt;b style=&#x27;font-size:14px&#x27;&gt;GitHub OIDC token → AWS STS&lt;/b&gt;&lt;br&gt;AssumeRoleWithWebIdentity&lt;br&gt;aud = sts.amazonaws.com&lt;br&gt;sub pinned to owner/repo IDs&lt;br&gt;≤ 1 hour credentials" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#13233F;strokeColor=#2DD4BF;strokeWidth=2;fontColor=#FFFFFF;fontSize=12;arcSize=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="420" y="600" width="300" height="140" as="geometry"/></mxCell><mxCell id="plan" value="&lt;b style=&#x27;font-size:14px&#x27;&gt;gha-p1-plan (read-only)&lt;/b&gt;&lt;br&gt;Trusted: …@1339061930:pull_request&lt;br&gt;Read P1 + state, write lock only&lt;br&gt;terraform plan → run summary" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#13233F;strokeColor=#34D399;strokeWidth=2;fontColor=#FFFFFF;fontSize=12;arcSize=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="820" y="330" width="340" height="130" as="geometry"/></mxCell><mxCell id="apply" value="&lt;b style=&#x27;font-size:14px&#x27;&gt;gha-p1-apply (P1 only)&lt;/b&gt;&lt;br&gt;Trusted: …:ref:refs/heads/main&lt;br&gt;Change bucket, CloudFront, headers&lt;br&gt;Deny: delete site, distribution, state&lt;br&gt;terraform apply" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#13233F;strokeColor=#34D399;strokeWidth=2;fontColor=#FFFFFF;fontSize=12;arcSize=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="820" y="600" width="340" height="150" as="geometry"/></mxCell><mxCell id="state" value="&lt;b style=&#x27;font-size:14px&#x27;&gt;S3 Terraform state&lt;/b&gt;&lt;br&gt;cloud-portfolio-tfstate-… · p1/terraform.tfstate&lt;br&gt;Native lock file (use_lockfile)&lt;br&gt;Private · versioned · AES256 · TLS-only&lt;br&gt;Old versions expire after 30 days" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#13233F;strokeColor=#2DD4BF;strokeWidth=2;fontColor=#FFFFFF;fontSize=12;arcSize=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1260" y="300" width="400" height="140" as="geometry"/></mxCell><mxCell id="site" value="&lt;b style=&#x27;font-size:14px&#x27;&gt;Project 1 site (live)&lt;/b&gt;&lt;br&gt;S3 private bucket + CloudFront OAC&lt;br&gt;✓ Security headers (HSTS preload, DENY)&lt;br&gt;✓ Versioning + 30-day lifecycle&lt;br&gt;✓ HTTPS end to end · HTTP/3&lt;br&gt;Shipped by PR #1 through the pipeline" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#13233F;strokeColor=#34D399;strokeWidth=2;fontColor=#FFFFFF;fontSize=12;arcSize=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1260" y="600" width="400" height="170" as="geometry"/></mxCell><mxCell id="bad" value="&lt;b style=&#x27;font-size:14px&#x27;&gt;Test PR · Block Public Access off&lt;/b&gt;&lt;br&gt;Checkov ✗ 5 checks (CKV_AWS_53-56,&lt;br&gt;  CKV2_AWS_6: Block Public Access)&lt;br&gt;Plan + apply skipped&lt;br&gt;Closed unmerged" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#13233F;strokeColor=#F87171;strokeWidth=2;fontColor=#FFFFFF;fontSize=12;arcSize=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="600" width="280" height="130" as="geometry"/></mxCell><mxCell id="audit" value="&lt;b style=&#x27;font-size:14px&#x27;&gt;CloudTrail + Access Analyzer&lt;/b&gt;&lt;br&gt;Every AssumeRoleWithWebIdentity logged&lt;br&gt;GitHub-trusted roles archived by rule" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#13233F;strokeColor=#60A5FA;strokeWidth=2;fontColor=#FFFFFF;fontSize=12;arcSize=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="420" y="800" width="300" height="100" as="geometry"/></mxCell><mxCell id="legend" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#13233F;strokeColor=#A9B8D6;dashed=1;" vertex="1" parent="1"><mxGeometry x="40" y="940" width="1620" height="100" as="geometry"/></mxCell><mxCell id="e0" value="git push" style="endArrow=block;endFill=1;html=1;strokeColor=#60A5FA;strokeWidth=2;fontColor=#FFFFFF;fontSize=11;labelBackgroundColor=#0B1426;edgeStyle=none;" edge="1" parent="1" source="dev" target="gh"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="migrate-state" style="endArrow=block;endFill=1;html=1;strokeColor=#60A5FA;strokeWidth=2;fontColor=#FFFFFF;fontSize=11;labelBackgroundColor=#0B1426;edgeStyle=none;" edge="1" parent="1" source="dev" target="state"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="every run" style="endArrow=block;endFill=1;html=1;strokeColor=#60A5FA;strokeWidth=2;fontColor=#FFFFFF;fontSize=11;labelBackgroundColor=#0B1426;edgeStyle=none;" edge="1" parent="1" source="gh" target="gate"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="pass" style="endArrow=block;endFill=1;html=1;strokeColor=#34D399;strokeWidth=2;fontColor=#FFFFFF;fontSize=11;labelBackgroundColor=#0B1426;edgeStyle=none;" edge="1" parent="1" source="gate" target="oidc"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="fail" style="endArrow=block;endFill=1;html=1;strokeColor=#F87171;strokeWidth=2;fontColor=#FFFFFF;fontSize=11;labelBackgroundColor=#0B1426;edgeStyle=none;" edge="1" parent="1" source="gate" target="bad"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="pull_request" style="endArrow=block;endFill=1;html=1;strokeColor=#2DD4BF;strokeWidth=2;fontColor=#FFFFFF;fontSize=11;labelBackgroundColor=#0B1426;edgeStyle=none;" edge="1" parent="1" source="oidc" target="plan"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="main" style="endArrow=block;endFill=1;html=1;strokeColor=#2DD4BF;strokeWidth=2;fontColor=#FFFFFF;fontSize=11;labelBackgroundColor=#0B1426;edgeStyle=none;" edge="1" parent="1" source="oidc" target="apply"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="read" style="endArrow=block;endFill=1;html=1;strokeColor=#2DD4BF;strokeWidth=2;fontColor=#FFFFFF;fontSize=11;labelBackgroundColor=#0B1426;edgeS