<mxfile host="app.diagrams.net"><diagram id="p10" name="P10 serverless v2"><mxGraphModel dx="1700" dy="920" grid="1" gridSize="10" guides="1" page="1" pageScale="1" pageWidth="1700" pageHeight="920" background="#0B1426" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Project 10 — Serverless pipeline v2: Project 4 rebuilt to fix the Project 8 findings, deployed keylessly" style="text;html=1;fontColor=#FFFFFF;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1620" height="50" as="geometry"/></mxCell><mxCell id="client" value="&lt;b style=&#x27;font-size:14px&#x27;&gt;Signed client (SigV4)&lt;/b&gt;&lt;br&gt;p10-api-client role&lt;br&gt;execute-api:Invoke on this API only&lt;br&gt;scripts/call_api.py&lt;br&gt;✓ unsigned call → 403" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#13233F;strokeColor=#60A5FA;strokeWidth=2;fontColor=#FFFFFF;fontSize=12;arcSize=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="300" height="140" as="geometry"/></mxCell><mxCell id="api" value="&lt;b style=&#x27;font-size:14px&#x27;&gt;HTTP API · p10-api&lt;/b&gt;&lt;br&gt;4 routes · AWS_IAM auth (F-42)&lt;br&gt;$default: 5 rps / burst 10 (F-43)&lt;br&gt;JSON access logs + caller (F-47)&lt;br&gt;✓ signed: 202 · 202 · 400" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#13233F;strokeColor=#2DD4BF;strokeWidth=2;fontColor=#FFFFFF;fontSize=12;arcSize=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="420" y="110" width="320" height="150" as="geometry"/></mxCell><mxCell id="ingest" value="&lt;b style=&#x27;font-size:14px&#x27;&gt;ingest Lambda&lt;/b&gt;&lt;br&gt;python3.12 · arm64 (F-50) · X-Ray&lt;br&gt;Validates → 400 / 413 / 202&lt;br&gt;Role: sqs:SendMessage only (F-38)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#13233F;strokeColor=#34D399;strokeWidth=2;fontColor=#FFFFFF;fontSize=12;arcSize=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="830" y="110" width="300" height="140" as="geometry"/></mxCell><mxCell id="queue" value="&lt;b style=&#x27;font-size:14px&#x27;&gt;SQS · p10-queue&lt;/b&gt;&lt;br&gt;Visibility 180 s = 6× timeout (F-44)&lt;br&gt;SSE-SQS · 4-day retention&lt;br&gt;Redrive after 3 receives" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#13233F;strokeColor=#2DD4BF;strokeWidth=2;fontColor=#FFFFFF;fontSize=12;arcSize=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1260" y="110" width="400" height="140" as="geometry"/></mxCell><mxCell id="query" value="&lt;b style=&#x27;font-size:14px&#x27;&gt;query Lambda&lt;/b&gt;&lt;br&gt;GET /data · /data/{id} · /stats&lt;br&gt;/stats reads counters, no Scan (F-48)&lt;br&gt;Role: GetItem / Scan only" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#13233F;strokeColor=#34D399;strokeWidth=2;fontColor=#FFFFFF;fontSize=12;arcSize=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="420" y="340" width="320" height="140" as="geometry"/></mxCell><mxCell id="process" value="&lt;b style=&#x27;font-size:14px&#x27;&gt;process Lambda&lt;/b&gt;&lt;br&gt;ESM batch 10 · max concurrency 2 (F-51)&lt;br&gt;ReportBatchItemFailures (F-45)&lt;br&gt;Idempotent TransactWriteItems&lt;br&gt;✓ duplicate stored once" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#13233F;strokeColor=#34D399;strokeWidth=2;fontColor=#FFFFFF;fontSize=12;arcSize=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="830" y="340" width="300" height="150" as="geometry"/></mxCell><mxCell id="dlq" value="&lt;b style=&#x27;font-size:14px&#x27;&gt;SQS · p10-dlq&lt;/b&gt;&lt;br&gt;14-day retention &amp;gt; source queue (F-46)&lt;br&gt;✓ poison message arrived after&lt;br&gt;   3 failed batch items" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#13233F;strokeColor=#F87171;strokeWidth=2;fontColor=#FFFFFF;fontSize=12;arcSize=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1260" y="340" width="400" height="130" as="geometry"/></mxCell><mxCell id="ci" value="&lt;b style=&#x27;font-size:14px&#x27;&gt;GitHub Actions (P9 pattern)&lt;/b&gt;&lt;br&gt;tests (moto) → Checkov → plan / apply&lt;br&gt;OIDC → gha-p10-plan / -apply&lt;br&gt;No AWS keys stored&lt;br&gt;State: tfstate …/p10/ (S3 lock)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#13233F;strokeColor=#60A5FA;strokeWidth=2;fontColor=#FFFFFF;fontSize=12;arcSize=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="340" width="300" height="150" as="geometry"/></mxCell><mxCell id="boundary" value="&lt;b style=&#x27;font-size:14px&#x27;&gt;Permissions boundary&lt;/b&gt;&lt;br&gt;p10-workload-boundary&lt;br&gt;Roles created only with it attached&lt;br&gt;PassRole to Lambda only&lt;br&gt;Deny: edit CI roles, boundary, state" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#13233F;strokeColor=#FBBF24;strokeWidth=2;fontColor=#FFFFFF;fontSize=12;arcSize=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="580" width="300" height="150" as="geometry"/></mxCell><mxCell id="roles" value="&lt;b style=&#x27;font-size:14px&#x27;&gt;Workload IAM roles&lt;/b&gt;&lt;br&gt;p10-ingest / process / query-role&lt;br&gt;p10-api-client&lt;br&gt;One role per function (F-38)&lt;br&gt;✓ all 4 carry the boundary" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#13233F;strokeColor=#2DD4BF;strokeWidth=2;fontColor=#FFFFFF;fontSize=12;arcSize=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="420" y="580" width="320" height="150" as="geometry"/></mxCell><mxCell id="tables" value="&lt;b style=&#x27;font-size:14px&#x27;&gt;DynamoDB (on demand)&lt;/b&gt;&lt;br&gt;p10-data · records&lt;br&gt;p10-stats · per-source counters&lt;br&gt;Deletion protection on (F-49)&lt;br&gt;✓ total_records 2 → 3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#13233F;strokeColor=#34D399;strokeWidth=2;fontColor=#FFFFFF;fontSize=12;arcSize=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="830" y="580" width="300" height="150" as="geometry"/></mxCell><mxCell id="alarms" value="&lt;b style=&#x27;font-size:14px&#x27;&gt;CloudWatch + SNS&lt;/b&gt;&lt;br&gt;p10-dlq-not-empty → email  ✓ ALARM&lt;br&gt;3 Lambda error alarms (F-39)&lt;br&gt;X-Ray traces · 14-day log retention (F-40)&lt;br&gt;Torn down after testing ✓ 0 left" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#13233F;strokeColor=#FBBF24;strokeWidth=2;fontColor=#FFFFFF;fontSize=12;arcSize=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1260" y="580" width="400" height="150" as="geometry"/></mxCell><mxCell id="legend" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#13233F;strokeColor=#A9B8D6;dashed=1;" vertex="1" parent="1"><mxGeometry x="40" y="790" width="1620" height="100" as="geometry"/></mxCell><mxCell id="e0" value="SigV4" style="endArrow=block;endFill=1;html=1;strokeColor=#60A5FA;strokeWidth=2;fontColor=#FFFFFF;fontSize=11;labelBackgroundColor=#0B1426;edgeStyle=none;" edge="1" parent="1" source="client" target="api"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="POST" style="endArrow=block;endFill=1;html=1;strokeColor=#2DD4BF;strokeWidth=2;fontColor=#FFFFFF;fontSize=11;labelBackgroundColor=#0B1426;edgeStyle=none;" edge="1" parent="1" source="api" target="ingest"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="GET routes" style="endArrow=block;endFill=1;html=1;strokeColor=#2DD4BF;strokeWidth=2;fontColor=#FFFFFF;fontSize=11;labelBackgroundColor=#0B1426;edgeStyle=none;" edge="1" parent="1" source="api" target="query"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="SendMessage" style="endArrow=block;endFill=1;html=1;strokeColor=#34D399;strokeWidth=2;fontColor=#FFFFFF;fontSize=11;labelBackgroundColor=#0B1426;edgeStyle=none;" edge="1" parent="1" source="ingest" target="queue"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="poll (ESM)" style="endArrow=block;endFill=1;html=1;strokeColor=#2DD4BF;strokeWidth=2;fontColor=#FFFFFF;fontSize=11;labelBackgroundColor=#0B1426;edgeStyle=none;" edge="1" parent="1" source="queue" target="process"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="write" style="endArrow=block;endFill=1;html=1;strokeColor=#34D399;strokeWidth=2;fontColor=#FFFFFF;fontSize=11;labelBackgroundColor=#0B1426;edgeStyle=none;" edge="1" parent="1" source="process" target="tables"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="read" style="endArrow=block;endFill=1;html=1;strokeColor=#34D399;strokeWidth=2;fontColor=#FFFFFF;fontSize=11;labelBackgroundColor=#0B1426;edgeStyle=none;" edge="1" parent="1" source="query" target="tables"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="3 failures" style="endArrow=block;endFill=1;html=1;strokeColor=#F87171;strokeWidth=2;fontColor=#FFFFFF;fontSize=11;labelBackgroundColor=#0B1426;edgeStyle=none;" edge="1" parent="1" source="queue" target="dlq"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="terraform apply" style="endArrow=block;endFill=1;html=1;strokeColor=#60A5FA;strokeWidth=2;fontColor=#FFFFFF;fontSize=11;labelBackgroundColor=#0B1426;edgeStyle=none;" edge="1" parent="1" source="ci" target="roles"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" value="governs" style="endArrow=block;endFill=1;html=1;strokeColor=#FBBF24;strokeWidth=2;fontColor=#FFFFFF;fontSize=11;labelBackgroundColor=#0B1426;edgeStyle=none;dashed=1;" edge="1" parent="1" source="boundary" target="roles"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e10" value="monitors" style="endArrow=block;endFill=1;html=1;strokeColor=#FBBF24;strokeWidth=2;fontColor=#FFFFFF;fontSize=11;labelBackgroundColor=#0B1426;edgeStyle=none;dashed=1;" edge="1" parent="1" source="alarms" target="dlq"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e11" value="monitors" style="endArrow=block;endFill=1;html=1;strokeColor=#FBBF24;strokeWidth=2;fontColor=#FFFFFF;fontSi