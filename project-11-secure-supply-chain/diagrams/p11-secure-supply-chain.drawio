<mxfile host="app.diagrams.net"><diagram id="p11" name="P11 secure supply chain"><mxGraphModel dx="1700" dy="990" grid="1" gridSize="10" guides="1" page="1" pageScale="1" pageWidth="1700" pageHeight="990" background="#0B1426" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Project 11 — Secure container supply chain: Project 3&#x27;s pipeline rebuilt, signed, scanned and deployed without SSH" style="text;html=1;fontColor=#FFFFFF;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1620" height="50" as="geometry"/></mxCell><mxCell id="repo" value="&lt;b style=&#x27;font-size:14px&#x27;&gt;GitHub repository&lt;/b&gt;&lt;br&gt;PR: tests, Checkov, build, gates&lt;br&gt;main: + publish, sign, deploy&lt;br&gt;Actions pinned by commit SHA&lt;br&gt;Least-privilege token per job" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#13233F;strokeColor=#60A5FA;strokeWidth=2;fontColor=#FFFFFF;fontSize=12;arcSize=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="320" height="160" as="geometry"/></mxCell><mxCell id="build" value="&lt;b style=&#x27;font-size:14px&#x27;&gt;Build once&lt;/b&gt;&lt;br&gt;Base image pinned by digest&lt;br&gt;Hash-locked deps · pip removed&lt;br&gt;uid 10001 · gunicorn · HEALTHCHECK&lt;br&gt;Debian security fixes at build" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#13233F;strokeColor=#34D399;strokeWidth=2;fontColor=#FFFFFF;fontSize=12;arcSize=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="430" y="110" width="320" height="160" as="geometry"/></mxCell><mxCell id="gates" value="&lt;b style=&#x27;font-size:14px&#x27;&gt;Gates (all must pass)&lt;/b&gt;&lt;br&gt;Checkov: Dockerfile + workflow&lt;br&gt;Smoke test · non-root check&lt;br&gt;Trivy (checksum-verified binary)&lt;br&gt;✓ blocked P3&amp;#x27;s image: zlib1g CVE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#13233F;strokeColor=#FBBF24;strokeWidth=2;fontColor=#FFFFFF;fontSize=12;arcSize=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="820" y="110" width="340" height="160" as="geometry"/></mxCell><mxCell id="publish" value="&lt;b style=&#x27;font-size:14px&#x27;&gt;Publish the tested image&lt;/b&gt;&lt;br&gt;Load the build&amp;#x27;s saved image, compare its ID&lt;br&gt;Push to GHCR by digest&lt;br&gt;✓ tested image ID = published digest&lt;br&gt;SBOM: CycloneDX, 96 components" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#13233F;strokeColor=#2DD4BF;strokeWidth=2;fontColor=#FFFFFF;fontSize=12;arcSize=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1230" y="110" width="430" height="160" as="geometry"/></mxCell><mxCell id="deploy" value="&lt;b style=&#x27;font-size:14px&#x27;&gt;Deploy job (OIDC, no keys)&lt;/b&gt;&lt;br&gt;Role gha-p11-deploy (main only)&lt;br&gt;May run only document p11-deploy&lt;br&gt;Only on Project=p11 instances&lt;br&gt;Deploy switch P11_DEPLOY_ENABLED&lt;br&gt;✓ AWS-RunShellScript: denied" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#13233F;strokeColor=#60A5FA;strokeWidth=2;fontColor=#FFFFFF;fontSize=12;arcSize=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="380" width="320" height="170" as="geometry"/></mxCell><mxCell id="ssm" value="&lt;b style=&#x27;font-size:14px&#x27;&gt;SSM document p11-deploy&lt;/b&gt;&lt;br&gt;One parameter: Digest&lt;br&gt;Must match ^sha256:[a-f0-9]{64}$&lt;br&gt;✓ $(reboot) and &amp;#x27;; reboot&amp;#x27;&lt;br&gt;   rejected before running" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#13233F;strokeColor=#FBBF24;strokeWidth=2;fontColor=#FFFFFF;fontSize=12;arcSize=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="430" y="380" width="320" height="170" as="geometry"/></mxCell><mxCell id="sigstore" value="&lt;b style=&#x27;font-size:14px&#x27;&gt;Sigstore (keyless)&lt;/b&gt;&lt;br&gt;cosign signs with the workflow&amp;#x27;s&lt;br&gt;GitHub OIDC identity&lt;br&gt;Fulcio certificate · Rekor log&lt;br&gt;✓ wrong workflow or branch: rejected" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#13233F;strokeColor=#2DD4BF;strokeWidth=2;fontColor=#FFFFFF;fontSize=12;arcSize=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="820" y="380" width="340" height="170" as="geometry"/></mxCell><mxCell id="ghcr" value="&lt;b style=&#x27;font-size:14px&#x27;&gt;GHCR · public package&lt;/b&gt;&lt;br&gt;p11-app, addressed by digest&lt;br&gt;Signature + SBOM attestation alongside&lt;br&gt;✓ verified from a laptop, outside CI&lt;br&gt;Every signed digest kept (rollback)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#13233F;strokeColor=#2DD4BF;strokeWidth=2;fontColor=#FFFFFF;fontSize=12;arcSize=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1230" y="380" width="430" height="170" as="geometry"/></mxCell><mxCell id="ec2" value="&lt;b style=&#x27;font-size:14px&#x27;&gt;EC2 t3.micro (us-east-1a)&lt;/b&gt;&lt;br&gt;No key pair · no port 22 · sshd off&lt;br&gt;In: TCP 80 · Out: TCP 443 only&lt;br&gt;IMDSv2, hop limit 1&lt;br&gt;cosign verify before docker pull&lt;br&gt;✓ unsigned digest: REFUSED" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#13233F;strokeColor=#34D399;strokeWidth=2;fontColor=#FFFFFF;fontSize=12;arcSize=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="430" y="650" width="320" height="170" as="geometry"/></mxCell><mxCell id="app" value="&lt;b style=&#x27;font-size:14px&#x27;&gt;Container p11-app&lt;/b&gt;&lt;br&gt;Read-only filesystem, tmpfs /tmp&lt;br&gt;All capabilities dropped&lt;br&gt;no-new-privileges · 80 → 8000&lt;br&gt;✓ reports the digest it runs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#13233F;strokeColor=#34D399;strokeWidth=2;fontColor=#FFFFFF;fontSize=12;arcSize=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="820" y="650" width="340" height="170" as="geometry"/></mxCell><mxCell id="user" value="&lt;b style=&#x27;font-size:14px&#x27;&gt;Visitor&lt;/b&gt;&lt;br&gt;http://&amp;lt;public IP&amp;gt;/&lt;br&gt;Response includes image_digest&lt;br&gt;✓ same digest in SSM, Docker, app&lt;br&gt;Live 5 h, then destroyed (0 left)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#13233F;strokeColor=#60A5FA;strokeWidth=2;fontColor=#FFFFFF;fontSize=12;arcSize=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1230" y="650" width="430" height="170" as="geometry"/></mxCell><mxCell id="legend" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#13233F;strokeColor=#A9B8D6;dashed=1;" vertex="1" parent="1"><mxGeometry x="40" y="870" width="1620" height="100" as="geometry"/></mxCell><mxCell id="e0" value="push" style="endArrow=block;endFill=1;html=1;strokeColor=#60A5FA;strokeWidth=2;fontColor=#FFFFFF;fontSize=11;labelBackgroundColor=#0B1426;edgeStyle=none;" edge="1" parent="1" source="repo" target="build"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="image" style="endArrow=block;endFill=1;html=1;strokeColor=#34D399;strokeWidth=2;fontColor=#FFFFFF;fontSize=11;labelBackgroundColor=#0B1426;edgeStyle=none;" edge="1" parent="1" source="build" target="gates"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="pass" style="endArrow=block;endFill=1;html=1;strokeColor=#FBBF24;strokeWidth=2;fontColor=#FFFFFF;fontSize=11;labelBackgroundColor=#0B1426;edgeStyle=none;" edge="1" parent="1" source="gates" target="publish"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="push" style="endArrow=block;endFill=1;html=1;strokeColor=#2DD4BF;strokeWidth=2;fontColor=#FFFFFF;fontSize=11;labelBackgroundColor=#0B1426;edgeStyle=none;" edge="1" parent="1" source="publish" target="ghcr"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="sign + attest" style="endArrow=block;endFill=1;html=1;strokeColor=#2DD4BF;strokeWidth=2;fontColor=#FFFFFF;fontSize=11;labelBackgroundColor=#0B1426;edgeStyle=none;" edge="1" parent="1" source="publish" target="sigstore"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="store" style="endArrow=block;endFill=1;html=1;strokeColor=#2DD4BF;strokeWidth=2;fontColor=#FFFFFF;fontSize=11;labelBackgroundColor=#0B1426;edgeStyle=none;" edge="1" parent="1" source="sigstore" target="ghcr"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="main + switch on" style="endArrow=block;endFill=1;html=1;strokeColor=#60A5FA;strokeWidth=2;fontColor=#FFFFFF;fontSize=11;labelBackgroundColor=#0B1426;edgeStyle=none;" edge="1" parent="1" source="repo" target="deploy"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="send" style="endArrow=block;endFill=1;html=1;strokeColor=#60A5FA;strokeWidth=2;fontColor=#FFFFFF;fontSize=11;labelBackgroundColor=#0B1426;edgeStyle=none;" edge="1" parent="1" source="deploy" target="ssm"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="runs on" style="endArrow=block;endFill=1;html=1;strokeColor=#FBBF24;strokeWidth=2;fontColor=#FFFFFF;fontSize=11;labelBackgroundColor=#0B1426;edgeStyle=none;" edge="1" parent="1" source="ssm" target="ec2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" value="verifies" style="endArrow=block;endFill=1;html=1;strokeColor=#FBBF24;strokeWidth=2;fontColor=#FFFFFF;fontSize=11;labelBackgroundColor=#0B1426;edgeStyle=none;dashed=1;" edge="1" parent="1" source="ec2" target="sigstore"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e10" value="pull by digest" style="endArrow=block;endFill=1;html=1;strokeColor=#2DD4BF;strokeWidth=2;fontColor=#FFFFFF;fontSize=11;labelBackgroundColor=#0B1426;edgeStyle=none;" edge="1" parent="1" source="ghcr" target="app"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e11" value="runs" style="endArrow=block;endFill=1;html=1;strokeColor=#34D399;strokeWidth=2;fontColor=#FFFFFF;fontSize=11;labelBackgroundColor=#0B1426;edgeStyle=none;" edge="1" parent="1" source="ec2" target="app"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e12" value="HTTP" style="endArrow=block;endFill=1;html=1;strokeColor=#60A5FA;strokeWidth=2;fontColor=#FFFFFF;fontSize=11;labelBackgroundColor=#0B1426;edgeStyle=none;" edge="1" parent="1" source="user" target="app"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="legtitle" value="&lt;b&gt;Legend&lt;/b&gt;" style="text;html=1;fontColor=#FFFFFF;fontSize=13;" vertex="1" parent="1"><mxGeometry x="60" y="878" width="120" height="24" as="geometry"/></mxCell><mxCell id="lg0" value="" style="rounded=1;html=1;fillColor=#13233F;strokeColor=#60A5FA;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="60" y="910" width="30" height="20" as="geometry"/></mxCell><mxCell id="lt0" value="GitHub / callers" style="text;html=1;fontColor=#FFFFFF;fontSize=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="100" y="910" width="135" height="20" as="geometry"/></mxCell><mxCell id="lg1" value="" style="rounded=1;html=1;fillColor=#13233F;strokeColor=#34D399;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="238" y="910" width="30" height="20" as="geometry"/></mxCell><mxCell id="lt1" value="Build / compute" style="text;html=1;fontColor=#FFFFFF;fontSize=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="278" y="910" width="135" height="20" as="geometry"/></mxCell><mxCell id="lg2" value="" style="rounded=1;html=1;fillColor=#13233F;strokeColor=#FBBF24;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="416" y="910" width="30" height="20" as="geometry"/></mxCell><mxCell id="lt2" value="Gates / controls" style="text;html=1;fontColor=#FFFFFF;fontSize=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="456" y="910" width="135" height="20" as="geometry"/></mxCell><mxCell id="lg3" value="" style="rounded=1;html=1;fillColor=#13233F;strokeColor=#2DD4BF;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="594" y="910" width="30" height="20" as="geometry"/></mxCell><mxCell id="lt3" value="Signing / registry" style="text;html=1;fontColor=#FFFFFF;fontSize=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="634" y="910" width="135" height="20" as="geometry"/></mxCell><mxCell id="lg4" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#60A5FA;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="772" y="920" as="sourcePoint"/><mxPoint x="806" y="920" as="targetPoint"/></mxGeometry></mxCell><mxCell id="lt4" value="flow" style="text;html=1;fontColor=#FFFFFF;fontSize=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="812" y="910" width="135" height="20" as="geometry"/></mxCell><mxCell id="lg5" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#FBBF24;strokeWidth=2;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="950" y="920" as="sourcePoint"/><mxPoint x="984" y="920" as="targetPoint"/></mxGeometry></mxCell><mxCell id="lt5" value="verifies" style="text;html=1;fontColor=#FFFFFF;fontSize=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="990" y="910" width="135" height="20" as="geometry"/></mxCell><mxCell id="lt6" value="✓ verified 2026-11-18 · Fixes P8 F-29, F-30, F-32 · USD 0 billed" style="text;html=1;fontColor=#FFFFFF;fontSize=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="940" width="900" height="20" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
