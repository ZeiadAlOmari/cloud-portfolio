<mxfile host="app.diagrams.net"><diagram id="p8" name="Portfolio WA map"><mxGraphModel dx="1700" dy="1080" grid="1" gridSize="10" guides="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1080" background="#0B1426" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Project 8 — Well-Architected Review of Projects 1–7 (6 pillars · Framework + Serverless lenses)" style="text;html=1;fontColor=#FFFFFF;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1620" height="56" as="geometry"/></mxCell><mxCell id="evidence" value="&lt;b style=&#x27;font-size:14px&#x27;&gt;Phase 0 · Evidence (read-only)&lt;/b&gt;&lt;br&gt;IAM credential report&lt;br&gt;CloudTrail Event History (90 days, free)&lt;br&gt;Direct-API sweep · us-east-1 + us-west-2&lt;br&gt;P4 terraform show -json snapshot&lt;br&gt;32 files sanitized · account ID redacted" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#13233F;strokeColor=#60A5FA;strokeWidth=2;fontColor=#FFFFFF;fontSize=12;arcSize=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="300" height="150" as="geometry"/></mxCell><mxCell id="watool" value="&lt;b style=&#x27;font-size:14px&#x27;&gt;AWS Well-Architected Tool&lt;/b&gt;&lt;br&gt;Workload: cloud-portfolio&lt;br&gt;Framework lens · 57 questions&lt;br&gt;Serverless lens · 9 questions&lt;br&gt;Answers scripted from findings" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#13233F;strokeColor=#60A5FA;strokeWidth=2;fontColor=#FFFFFF;fontSize=12;arcSize=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="330" width="300" height="140" as="geometry"/></mxCell><mxCell id="miles" value="&lt;b style=&#x27;font-size:14px&#x27;&gt;Milestones (High / Medium / None)&lt;/b&gt;&lt;br&gt;M1 Baseline          40 / 16 / 1&lt;br&gt;M2 Post-remediation  39 / 17 / 1&lt;br&gt;M3 Short-lived creds  39 / 17 / 1&lt;br&gt;Serverless lens        7 / 2 (all)&lt;br&gt;0 unanswered" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#13233F;strokeColor=#60A5FA;strokeWidth=2;fontColor=#FFFFFF;fontSize=12;arcSize=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="530" width="300" height="150" as="geometry"/></mxCell><mxCell id="register" value="&lt;b style=&#x27;font-size:14px&#x27;&gt;Findings register · 69&lt;/b&gt;&lt;br&gt;12 High · 24 Medium · 17 Low&lt;br&gt;13 remediated (3 High)&lt;br&gt;10 cost decisions · 25 design findings&lt;br&gt;2 lessons · 12 strengths" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#13233F;strokeColor=#60A5FA;strokeWidth=2;fontColor=#FFFFFF;fontSize=12;arcSize=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="740" width="300" height="150" as="geometry"/></mxCell><mxCell id="account" value="&lt;b style=&#x27;font-size:15px&#x27;&gt;AWS Account Baseline (us-east-1)&lt;/b&gt;&lt;br&gt;✓ Root MFA, no root keys&lt;br&gt;✓ CLI on aws login short-lived creds (F-02)&lt;br&gt;✓ Password policy 14 chars / 24 reuse (F-03)&lt;br&gt;✓ IAM Access Analyzer · 0 findings (F-35)&lt;br&gt;✓ Budget + USD 0.01 alert (F-63)&lt;br&gt;$ No trail → Event History (F-01)&lt;br&gt;$ No Identity Center → Free Plan (F-66)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#13233F;strokeColor=#2DD4BF;strokeWidth=2;fontColor=#FFFFFF;fontSize=12;arcSize=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="640" y="420" width="420" height="230" as="geometry"/></mxCell><mxCell id="p1" value="&lt;b style=&#x27;font-size:14px&#x27;&gt;P1 Static site · LIVE&lt;/b&gt;&lt;br&gt;S3 + CloudFront&lt;br&gt;✓ OAC, private bucket, BPA on (F-04)&lt;br&gt;✓ HTTPS origin + SigV4 (F-05)&lt;br&gt;✓ HTTP/3 (F-58)&lt;br&gt;$ TLSv1 min on default cert (F-55)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#13233F;strokeColor=#34D399;strokeWidth=2;fontColor=#FFFFFF;fontSize=12;arcSize=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="450" y="120" width="300" height="150" as="geometry"/></mxCell><mxCell id="p2" value="&lt;b style=&#x27;font-size:14px&#x27;&gt;P2 Multi-tier app · torn down&lt;/b&gt;&lt;br&gt;VPC 3 tiers · Nginx · Flask · RDS&lt;br&gt;✗ SSH 0.0.0.0/0 (F-12)&lt;br&gt;✗ DB creds hardcoded (F-13)&lt;br&gt;$ Single AZ, no ALB/ASG (F-17)&lt;br&gt;! RDS unencrypted (F-14)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#13233F;strokeColor=#F87171;strokeWidth=2;fontColor=#FFFFFF;fontSize=12;arcSize=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="850" y="120" width="300" height="150" as="geometry"/></mxCell><mxCell id="p3" value="&lt;b style=&#x27;font-size:14px&#x27;&gt;P3 CI/CD pipeline · torn down&lt;/b&gt;&lt;br&gt;GitHub Actions → SSH → EC2&lt;br&gt;✗ Static keys + SSH key, no OIDC (F-23)&lt;br&gt;✗ Port 22 open for deploy (F-29)&lt;br&gt;! Tested ≠ deployed artifact (F-30)&lt;br&gt;! No image scan, tag-pinned action (F-32)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#13233F;strokeColor=#F87171;strokeWidth=2;fontColor=#FFFFFF;fontSize=12;arcSize=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1250" y="120" width="300" height="150" as="geometry"/></mxCell><mxCell id="p4" value="&lt;b style=&#x27;font-size:14px&#x27;&gt;P4 Serverless · destroyed&lt;/b&gt;&lt;br&gt;API → Lambda → SQS → Lambda → DynamoDB&lt;br&gt;✓ Left live 8 weeks → destroyed (F-36)&lt;br&gt;✗ API auth NONE (F-42)&lt;br&gt;✗ No throttling (F-43)&lt;br&gt;! Shared IAM role, no alarms (F-38, F-39)&lt;br&gt;✓ DLQ + redrive (F-41)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#13233F;strokeColor=#F87171;strokeWidth=2;fontColor=#FFFFFF;fontSize=12;arcSize=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1250" y="440" width="300" height="170" as="geometry"/></mxCell><mxCell id="p5" value="&lt;b style=&#x27;font-size:14px&#x27;&gt;P5 Kubernetes · torn down&lt;/b&gt;&lt;br&gt;k3s on one t3.micro&lt;br&gt;$ Single node / AZ (F-06)&lt;br&gt;! NodePort, no TLS (F-07)&lt;br&gt;✓ EKS avoided (~USD 73/mo)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#13233F;strokeColor=#F87171;strokeWidth=2;fontColor=#FFFFFF;fontSize=12;arcSize=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1250" y="760" width="300" height="140" as="geometry"/></mxCell><mxCell id="p6" value="&lt;b style=&#x27;font-size:14px&#x27;&gt;P6 Security baseline · torn down&lt;/b&gt;&lt;br&gt;Trail, password policy, analyzer&lt;br&gt;! Teardown removed account&lt;br&gt;  controls → regression (F-01/03/35)&lt;br&gt;✓ Restored in P8 (free items)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#13233F;strokeColor=#FBBF24;strokeWidth=2;fontColor=#FFFFFF;fontSize=12;arcSize=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="850" y="760" width="300" height="140" as="geometry"/></mxCell><mxCell id="p7" value="&lt;b style=&#x27;font-size:14px&#x27;&gt;P7 Multi-region DR · torn down&lt;/b&gt;&lt;br&gt;S3 CRR + CloudFront failover&lt;br&gt;! RPO from one 26s sample (F-08)&lt;br&gt;! One-way, manual failback (F-09)&lt;br&gt;✓ Failover tested (0.57s → 1.03s)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#13233F;strokeColor=#FBBF24;strokeWidth=2;fontColor=#FFFFFF;fontSize=12;arcSize=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="450" y="760" width="300" height="140" as="geometry"/></mxCell><mxCell id="legend" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#13233F;strokeColor=#A9B8D6;dashed=1;" vertex="1" parent="1"><mxGeometry x="40" y="950" width="1620" height="100" as="geometry"/></mxCell><mxCell id="e0" value="answers" style="endArrow=block;endFill=1;html=1;strokeColor=#60A5FA;strokeWidth=2;fontColor=#FFFFFF;fontSize=11;labelBackgroundColor=#0B1426;edgeStyle=none;" edge="1" parent="1" source="evidence" target="watool"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="milestones" style="endArrow=block;endFill=1;html=1;strokeColor=#60A5FA;strokeWidth=2;fontColor=#FFFFFF;fontSize=11;labelBackgroundColor=#0B1426;edgeStyle=none;" edge="1" parent="1" source="watool" target="miles"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="risk counts" style="endArrow=block;endFill=1;html=1;strokeColor=#60A5FA;strokeWidth=2;fontColor=#FFFFFF;fontSize=11;labelBackgroundColor=#0B1426;edgeStyle=none;" edge="1" parent="1" source="miles" target="register"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="live checks" style="endArrow=block;endFill=1;html=1;strokeColor=#60A5FA;strokeWidth=2;fontColor=#FFFFFF;fontSize=11;labelBackgroundColor=#0B1426;edgeStyle=none;" edge="1" parent="1" source="evidence" target="p1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="reviews" style="endArrow=block;endFill=1;html=1;strokeColor=#FBBF24;strokeWidth=2;fontColor=#FFFFFF;fontSize=11;labelBackgroundColor=#0B1426;edgeStyle=none;dashed=1;" edge="1" parent="1" source="watool" target="account"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#2DD4BF;strokeWidth=2;fontColor=#FFFFFF;fontSize=11;labelBackgroundColor=#0B1426;edgeStyle=none;dashed=1;" edge="1" parent="1" source="account" target="p1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#2DD4BF;strokeWidth=2;fontColor=#FFFFFF;fontSize=11;labelBackgroundColor=#0B1426;edgeStyle=none;dashed=1;" edge="1" parent="1" source="account" target="p2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#2DD4BF;strokeWidth=2;fontColor=#FFFFFF;fontSize=11;labelBackgroundColor=#0B1426;edgeStyle=none;dashed=1;" edge="1" parent="1" source="account" target="p3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#2DD4BF;strokeWidth=2;fontColor=#FFFFFF;fontSize=11;labelBackgroundColor=#0B1426;edgeStyle=none;dashed=1;" edge="1" parent="1" source="account" target="p4"><